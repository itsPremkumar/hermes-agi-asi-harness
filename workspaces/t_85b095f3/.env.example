# AgentOS Environment Configuration
# Copy this file to .env and fill in your values

# Database
AGENTOS_DB_PATH=:memory:
AGENTOS_LOG_LEVEL=INFO

# Dashboard
AGENTOS_DASHBOARD_HOST=127.0.0.1
AGENTOS_DASHBOARD_PORT=8080

# Scheduler defaults
AGENTOS_MAX_CONCURRENT=4
AGENTOS_MAX_CPU=8.0
AGENTOS_MAX_MEMORY=16384

# Observability
AGENTOS_SERVICE_NAME=agentos
AGENTOS_ENABLE_TRACES=true
AGENTOS_ENABLE_METRICS=true

# Multi-tenancy
AGENTOS_DEFAULT_TENANT=default
