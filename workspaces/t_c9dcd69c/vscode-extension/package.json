{
  "name": "mcphub-vscode",
  "displayName": "MCPHub",
  "description": "Discover and install MCP servers from MCPHub registry",
  "version": "1.0.0",
  "publisher": "mcphub",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other", "Machine Learning", "Snippets"],
  "keywords": ["mcp", "model-context-protocol", "ai", "agents"],
  "activationEvents": [
    "onCommand:mcphub.search",
    "onCommand:mcphub.install",
    "onCommand:mcphub.browse"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mcphub.search",
        "title": "MCPHub: Search Servers"
      },
      {
        "command": "mcphub.install",
        "title": "MCPHub: Install Server"
      },
      {
        "command": "mcphub.browse",
        "title": "MCPHub: Browse Registry"
      },
      {
        "command": "mcphub.submit",
        "title": "MCPHub: Submit Server"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcphub-sidebar",
          "title": "MCPHub",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "mcphub-sidebar": [
        {
          "id": "mcphubServers",
          "name": "Featured Servers"
        }
      ]
    },
    "configuration": {
      "title": "MCPHub",
      "properties": {
        "mcphub.apiUrl": {
          "type": "string",
          "default": "http://localhost:8000/api/v1",
          "description": "MCPHub API URL"
        },
        "mcphub.autoInstall": {
          "type": "boolean",
          "default": false,
          "description": "Auto-install servers without confirmation"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.24.0"
  }
}
