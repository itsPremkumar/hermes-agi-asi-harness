# ContextVault environment configuration
# Copy this file to .env and adjust values as needed

# Server Configuration
CONTEXTVAULT_HOST=0.0.0.0
CONTEXTVAULT_HTTP_PORT=8000
CONTEXTVAULT_GRPC_PORT=50051

# Storage
CONTEXTVAULT_PERSIST_PATH=./data
CONTEXTVAULT_DIMENSION=128
CONTEXTVAULT_INDEX_TYPE=flat

# Database (optional - for PostgreSQL backend)
# CONTEXTVAULT_DATABASE_URL=postgresql://user:password@localhost:5432/contextvault

# Logging
CONTEXTVAULT_LOG_LEVEL=info
CONTEXTVAULT_LOG_FORMAT=json

# Embedding Provider (hash or sentence-transformers)
CONTEXTVAULT_EMBEDDING_PROVIDER=hash
# CONTEXTVAULT_EMBEDDING_MODEL=all-MiniLM-L6-v2

# TTL and Archival
CONTEXTVAULT_DEFAULT_TTL_SECONDS=86400
CONTEXTVAULT_COLD_STORAGE_PATH=./cold
CONTEXTVAULT_ENABLE_ARCHIVAL=true

# Access Control
CONTEXTVAULT_DEFAULT_ACCESS_LEVEL=private
CONTEXTVAULT_ENABLE_AUDIT_LOG=true

# Kubernetes
CONTEXTVAULT_NAMESPACE=contextvault
CONTEXTVAULT_REPLICAS=3
CONTEXTVAULT_STORAGE_SIZE=10Gi

# Performance
CONTEXTVAULT_MAX_CONNECTIONS=100
CONTEXTVAULT_SEARCH_TIMEOUT_MS=5000
CONTEXTVAULT_CACHE_SIZE=10000
