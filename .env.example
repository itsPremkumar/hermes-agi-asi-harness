# Hermes AGI/ASI Harness — environment template.
# Copy to `.env` (never commit `.env`) and fill in values.
# The harness runs offline-first; every key below is OPTIONAL.

# --- LLM providers (free-tier friendly; leave blank for offline/local-only) ---
# OPENROUTER_API_KEY=
# NVIDIA_NIM_API_KEY=
# HERMES_MODEL=

# --- Dashboard / API (local only by default) ---
# HERMES_API_KEY=
# HERMES_API_PORT=8471

# --- Telemetry / eval (all optional) ---
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=hermes-agi-asi-harness

# --- Daemon runtime ---
# HERMES_WORKSPACE=.hermes
# HERMES_DAEMON_POLL_SECONDS=2.0
