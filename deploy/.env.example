# LLM API Keys — NEVER commit real keys to git
# Create a copy: cp .env.example .env and fill in real values

LLM_API_KEY=your_api_key_here

# Database
DATABASE_URL=postgresql://hermes:CHANGE_ME@postgres:5432/hermes
POSTGRES_PASSWORD=CHANGE_ME

# Redis
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
REDIS_PASSWORD=CHANGE_ME

# Logging
LOG_LEVEL=INFO

# Plane Configuration
PLANE_TIMEOUT_SECONDS=300
COST_BUDGET_PER_QUERY=0.50

# Grafana
GRAFANA_PASSWORD=admin

# Docker Registry
DOCKER_REGISTRY=your-registry.azurecr.io
IMAGE_TAG=latest
